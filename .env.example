# Copy to .env (public build-time values only, never secrets).
# The Discord application id is public: it is visible to every player of the Activity.
EXPO_PUBLIC_DISCORD_CLIENT_ID=your_discord_application_id

# Optional: point the app at another Supabase project, e.g. a local `npx supabase start`
# (put these in .env.local, which git ignores; the defaults are the production project).
# EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# EXPO_PUBLIC_SUPABASE_ANON_KEY=
